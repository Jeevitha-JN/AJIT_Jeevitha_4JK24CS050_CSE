//to find the min amd max in array//public class Main {
    public static void main(String[] args) {
        int[] arr = {3, 7, 2, 9, 1, 5};
        int min = arr[0];
        int max = arr[0];
        for (int i = 1; i < arr.length; i++) {
            if (arr[i] < min) {
                min = arr[i];
            }
            if (arr[i] > max) {
                max = arr[i];
            }
        }
        System.out.println("Min: " + min);
        System.out.println("Max: " + max);
    }
}


//largest and smallest
public class FindMinMax {
    public static void main(String[] args) {
        int[] arr = {12, 45, 7, 89, 23, 4, 67};

        int min = arr[0];
        int max = arr[0];

        for (int i = 1; i < arr.length; i++) {
            if (arr[i] < min) {
                min = arr[i];
            }
            if (arr[i] > max) {
                max = arr[i];
            }
        }

        System.out.println("Smallest element: " + min);
        System.out.println("Largest element: " + max);
    }
}

//kth largest and kth samllest//
import java.util.Arrays;

public class MinMaxK {
    public static void main(String[] args) {
        int[] arr = {10, 5, 20, 3, 8};
        int k = 2; // change k as needed

        Arrays.sort(arr);

        int min = arr[0];
        int max = arr[arr.length - 1];
        int kthSmallest = arr[k - 1];
        int kthLargest = arr[arr.length - k];

        System.out.println("Min: " + min);
        System.out.println("Max: " + max);
        System.out.println("Kth Smallest: " + kthSmallest);
        System.out.println("Kth Largest: " + kthLargest);
    }
}
