//string to in reverse words//
public class Main {
    public static void main(String[] args) {
        String s = "Hello World Java";
        String[] words = s.split(" ");
        String reversed = "";
        for (int i = words.length - 1; i >= 0; i--) {
            reversed += words[i] + " ";
        }
        
        System.out.println(reversed.trim());
    }
}
